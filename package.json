    "dev:landing": "npm run dev --workspace c-companion-landing"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "workspaces": [
    "landing"
  ]
}
