{
  "name": "c-companion",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run build --workspace c-companion-landing && node ops/copy-landing.mjs",
    "test": "node --test app/*.test.mjs",
    "test:e2e": "playwright test",
    "evaluate": "node evaluation/check.mjs",
